DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_OWNER_ID=
DATABASE_URL=postgresql://identity_bot:change-me@postgres.private:5432/vanity_tag_bot?sslmode=require

# Optional runtime settings.
MIGRATIONS_DIR=migrations
HTTP_ADDR=:8080
# Leave these as 1 and 0 for one Discloud instance. If sharding is needed,
# run one instance per shard with the same SHARD_COUNT and a unique SHARD_ID.
SHARD_COUNT=1
SHARD_ID=0
PRESENCE_TEXT=Vanity & Guild Tags
REQUEST_TIMEOUT_SECONDS=10
GUILD_QUEUE_SIZE=64

# Optional allowlist for developer-only diagnostics, comma separated.
DEVELOPER_IDS=

# Public links used by onboarding and help.
WEBSITE_URL=https://petto.sbs
DASHBOARD_URL=https://petto.sbs/dash
DOCS_URL=https://wiki.petto.sbs
SUPPORT_URL=https://petto.sbs/support

# Set to false until the first production rollout is verified.
ENABLE_MEMBER_RECONCILIATION=false
RECONCILIATION_INTERVAL_MINUTES=60
RECONCILIATION_MAX_USERS=250
RECONCILIATION_CONCURRENCY=2

# Explicit /vanity sync and /guildtag sync limits. Manual sync is separate from
# the background reconciler and shows live progress in the private response.
MANUAL_SYNC_MAX_USERS=1000
MANUAL_SYNC_CONCURRENCY=4

# Required before using /config profile avatar or banner. Keep this allowlist
# limited to the private asset hosts your deployment explicitly trusts.
ASSET_ALLOWED_HOSTS=
ASSET_MAX_BYTES=8388608
ASSET_MAX_PIXELS=16777216

# Petto-compatible application emoji IDs. Keep these configurable so the new bot
# can use the same emojis without sharing Petto's database or runtime.
EMOJI_STAR=<:peto_star:1527894282135146516>
EMOJI_APPROVE=<:petto_approve:1527894552277549066>
EMOJI_DENY=<:petto_deny:1527894509579665458>
EMOJI_ALERT=<:petto_alert:1527894204926267483>
EMOJI_WARNING=<:petto_warning:1527894476616630433>
EMOJI_HAMMER=<:petto_hammer:1527894325432815817>
EMOJI_PREV=<:42:1529270178985148579>
EMOJI_NEXT=<:41:1529270176070107187>
EMOJI_CLOSE=<:40:1529270174086336747>
